daemon off;
worker_processes 1;
user nginx;
pid /run/nginx/toposync.pid;
error_log /dev/null;
events { worker_connections 1024; }
http {
    access_log off;
    server_tokens off;
    charset utf-8;
    absolute_redirect off;
    client_body_temp_path /run/nginx/client_temp;
    proxy_temp_path /run/nginx/proxy_temp;
    resolver __RESOLVERS__ valid=30s;
    resolver_timeout 5s;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_x_forwarded_proto $public_scheme { default $scheme; https https; http http; }
    map $http_x_ingress_path $valid_ingress_path {
        default 0;
        ~^/api/hassio_ingress/[A-Za-z0-9_-]+$ 1;
    }
    map $http_accept_language $proxy_language {
        default en;
        "~*^pt(?:-|,|;|$)" pt-BR;
    }
    map $proxy_language $authentication_error {
        default "Toposync Remote Instance: access denied.\nCheck the access token, trusted source address and Home Assistant user. See Documentation in the add-on.\n";
        pt-BR "Toposync — Instância remota: acesso negado.\nConfira a credencial de acesso, o endereço de origem permitido e o usuário do Home Assistant. Consulte Documentação no complemento.\n";
    }
    map $proxy_language $connection_error {
        default "Toposync Remote Instance: connection unavailable.\nCheck the remote instance address, network and HTTPS certificate. The server must support authenticated ingress proxy. See Documentation in the add-on, then reload this page.\n";
        pt-BR "Toposync — Instância remota: conexão indisponível.\nConfira o endereço da instância remota, a rede e o certificado HTTPS. O servidor precisa oferecer suporte ao proxy autenticado de Ingress. Consulte Documentação no complemento e recarregue esta página.\n";
    }
    server {
        listen 127.0.0.1:8098;
        location / { default_type text/plain; return 200 "ok\n"; }
    }
    server {
        listen 8099;
        allow 172.30.32.2;
        deny all;
        set $upstream_origin "__ORIGIN__";
        client_max_body_size 1g;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_ssl_server_name on;
        proxy_ssl_name __TLS_NAME__;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 5;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        error_page 401 403 = @authentication_error;
        error_page 500 502 503 504 = @connection_error;

        location = /_toposync_proxy_auth {
            internal;
            proxy_method GET;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Upgrade "";
            proxy_set_header Connection "";
            __HEADERS__
            proxy_pass $upstream_origin/api/auth/ingress-proxy;
        }
        location / {
            if ($valid_ingress_path = 0) { return 403; }
            if ($http_x_remote_user_id = "") { return 401; }
            auth_request /_toposync_proxy_auth;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            __HEADERS__
            proxy_cookie_path / $http_x_ingress_path/;
            proxy_redirect ~^https?://[^/]+(/api/hassio_ingress/.*)$ $1;
            proxy_redirect ~^(/api/hassio_ingress/.*)$ $1;
            proxy_redirect "~^https?://__REDIRECT_AUTHORITY__(/.*)$" $http_x_ingress_path$1;
            proxy_redirect $public_scheme://$http_host/ $http_x_ingress_path/;
            proxy_redirect / $http_x_ingress_path/;
            proxy_intercept_errors off;
            proxy_pass $upstream_origin$request_uri;
        }
        location @authentication_error {
            default_type text/plain;
            add_header Content-Language $proxy_language always;
            add_header Vary Accept-Language always;
            add_header Cache-Control no-store always;
            return 403 $authentication_error;
        }
        location @connection_error {
            default_type text/plain;
            add_header Content-Language $proxy_language always;
            add_header Vary Accept-Language always;
            add_header Cache-Control no-store always;
            return 502 $connection_error;
        }
    }
}
